# include_str! fixtures are compared byte-for-byte; autocrlf would add \r on Windows.
src/terminal/view/fixtures/*.txt -text

# Pinned third-party asset verified by SHA-256 in scripts/prepare-conpty.ps1;
# must be checked out byte-for-byte.
assets/windows/conpty/LICENSE.txt -text

# Bash scripts break with CRLF ($'\r': command not found / invalid option name);
# CI boundary checks also rely on LF sources.
*.sh text eol=lf

# draw.io engine and our bridge pages are hash-pinned byte-for-byte.
assets/drawio/** -text
src/ui/code_editor/drawio_engine/web/** -text

# WebView2 loader is redistributed byte-for-byte.
assets/windows/webview2/** -text
